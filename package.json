{
  "name": "bnd-tools",
  "displayName": "Bnd Support",
  "description": "Minimal bnd/Bndtools workflow support for IBM Bob (build, resolve, run .bndrun files)",
  "version": "0.0.11",
  "publisher": "fezzyBug",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages", "Other"],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/cnf/build.bnd",
    "workspaceContains:**/*.bnd",
    "workspaceContains:**/*.bndrun",
    "onLanguage:bnd"
  ],
  "main": "./out/extension.js",
  "icon": "./icons/bnd_bundles.png",
  "contributes": {
    "languages": [
      {
        "id": "bnd",
        "aliases": ["Bnd", "bnd"],
        "extensions": [".bnd", ".bndrun"],
        "filenames": ["bnd.bnd", "build.bnd"],
        "configuration": "./language-configuration/bnd.json"
      }
    ],
    "grammars": [
      {
        "language": "bnd",
        "scopeName": "source.bnd",
        "path": "./syntaxes/bnd.tmLanguage.json"
      }
    ],
    "colors": [
      {
        "id": "bndTools.fileBadgeForeground",
        "description": "Foreground color for Bnd file badges.",
        "defaults": {
          "light": "#B54708",
          "dark": "#F79009"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bnd",
          "title": "Bnd",
          "icon": "./icons/bnd_bundles.png"
        }
      ]
    },
    "views": {
      "bnd": [
        {
          "id": "bnd.hub",
          "name": "Bnd Hub"
        }
      ]
    },
    "commands": [
      {
        "command": "bnd.refreshHub",
        "title": "Bnd: Refresh Hub",
        "icon": "$(refresh)"
      },
      {
        "command": "bnd.buildWorkspace",
        "title": "Bnd: Build Workspace",
        "category": "Bnd"
      },
      {
        "command": "bnd.buildProject",
        "title": "Bnd: Build Project",
        "category": "Bnd"
      },
      {
        "command": "bnd.clean",
        "title": "Bnd: Clean",
        "category": "Bnd"
      },
      {
        "command": "bnd.resolveBndrun",
        "title": "Bnd: Resolve",
        "category": "Bnd"
      },
      {
        "command": "bnd.runBndrun",
        "title": "Bnd: Run",
        "category": "Bnd"
      },
      {
        "command": "bnd.showProjectInfo",
        "title": "Bnd: Show Project Information",
        "category": "Bnd"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bnd.refreshHub",
          "when": "view == bnd.hub",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "bnd.buildWorkspace",
          "when": "view == bnd.hub && viewItem =~ /bnd(Descriptor|Runtime)/",
          "group": "bnd@1"
        },
        {
          "command": "bnd.buildProject",
          "when": "view == bnd.hub && viewItem =~ /bnd(Descriptor|Runtime)/",
          "group": "bnd@2"
        },
        {
          "command": "bnd.clean",
          "when": "view == bnd.hub && viewItem =~ /bnd(Descriptor|Runtime)/",
          "group": "bnd@3"
        },
        {
          "command": "bnd.showProjectInfo",
          "when": "view == bnd.hub && viewItem =~ /bnd(Descriptor|Runtime)/",
          "group": "bnd@4"
        },
        {
          "command": "bnd.resolveBndrun",
          "when": "view == bnd.hub && viewItem == bndRuntime",
          "group": "bnd@5"
        },
        {
          "command": "bnd.runBndrun",
          "when": "view == bnd.hub && viewItem == bndRuntime",
          "group": "bnd@6"
        }
      ],
      "editor/title": [
        {
          "command": "bnd.runBndrun",
          "when": "resourceExtname == .bndrun",
          "group": "navigation"
        },
        {
          "command": "bnd.resolveBndrun",
          "when": "resourceExtname == .bndrun",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "bnd.buildWorkspace",
          "when": "resourceExtname == .bnd || resourceExtname == .bndrun",
          "group": "bnd@1"
        },
        {
          "command": "bnd.buildProject",
          "when": "resourceExtname == .bnd || resourceExtname == .bndrun",
          "group": "bnd@2"
        },
        {
          "command": "bnd.clean",
          "when": "resourceExtname == .bnd || resourceExtname == .bndrun",
          "group": "bnd@3"
        },
        {
          "command": "bnd.showProjectInfo",
          "when": "resourceExtname == .bnd || resourceExtname == .bndrun",
          "group": "bnd@4"
        },
        {
          "command": "bnd.resolveBndrun",
          "when": "resourceExtname == .bndrun",
          "group": "bnd@5"
        },
        {
          "command": "bnd.runBndrun",
          "when": "resourceExtname == .bndrun",
          "group": "bnd@6"
        }
      ]
    },
    "configuration": {
      "title": "Bnd Tools",
      "properties": {
        "bnd.cliPath": {
          "type": "string",
          "default": "bnd",
          "description": "Path to the bnd CLI executable. Defaults to 'bnd' on PATH."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.24.0"
  }
}
